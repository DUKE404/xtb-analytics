# Hasło do aplikacji. Ustaw je zawsze, gdy aplikacja ma publiczny adres (np. na Render).
APP_PASSWORD=

# Opcjonalnie: klucz API Anthropic włącza dział "AI" (memo ryzyka + czat).
# Skopiuj ten plik jako ".env" i wklej klucz. Bez klucza aplikacja działa w pełni, tylko bez działu AI.
ANTHROPIC_API_KEY=
# Opcjonalnie: model używany do memo i czatu.
ANTHROPIC_MODEL=claude-sonnet-5-5
