# Baza kont i zaszyfrowanych portfeli (Postgres, np. darmowy Neon). Bez niej: plik .cache/accounts.sqlite.
# DATABASE_URL=postgresql://user:haslo@host/baza?sslmode=require

# Kod konfiguracji: wymagany do założenia pierwszego konta (administratora). Ustaw go zawsze w chmurze.
APP_PASSWORD=

# Sekret serwera (dowolny długi losowy ciąg). Render generuje go sam.
SECRET_KEY=

# Opcjonalnie: klucz API Anthropic włącza dział "AI" (memo ryzyka + czat).
ANTHROPIC_API_KEY=
# Opcjonalnie: model używany do memo i czatu.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcjonalnie: darmowy klucz FRED (fredaccount.stlouisfed.org) - oficjalne terminy publikacji z USA w kalendarzu makro.
FRED_API_KEY=

# Katalog na pobrane notowania (domyślnie .cache). Na serwerze z trwałym dyskiem wskaż ten dysk.
# CACHE_DIR=/var/data
